# DocChat 설정 — 이 파일을 `.env`로 복사한 뒤 바꿀 줄의 `#`를 지우고 값을 고친다.
#
#   - 적지 않은 값은 app/config.py의 기본값을 쓴다(아래에 적힌 값이 기본값이다).
#   - 셸에서 준 환경변수가 이 파일보다 우선한다.
#   - 바꾼 뒤에는 서버를 다시 띄워야 한다.
#   - API key는 여기에 적지 않는다. 설정 화면에서 입력하면 요청 때만 쓰이고 저장되지 않는다.

# ─── 서버 ────────────────────────────────────────────────────────────────
# DOCCHAT_HOST=127.0.0.1
# DOCCHAT_PORT=8000
# DOCCHAT_DB_PATH=data/docchat.sqlite
# DOCCHAT_FILES_DIR=data/files            # 기본은 DB 파일 옆의 files/. DB와 짝으로 옮긴다

# ─── 개발·실험 ────────────────────────────────────────────────────────────
# DOCCHAT_DEBUG_TRACE=1                   # 턴 트레이스(Step 7): 한 턴의 전처리·전사·모델 호출·도구 실행을 turn_traces에 기록,
#                                         #   답변마다 "과정 보기". 타일 모드에서는 모델에 보낸 타일도 data/files/{대화ID}/tiles/ 에 저장
# DOCCHAT_TRACE_TEXT_LIMIT=40000          # 트레이스에 남기는 글 한 조각(메시지·응답·도구 결과)의 최대 글자 수

# ─── 이미지 처리 방식 (전체 / 타일) ───────────────────────────────────────
# DOCCHAT_IMAGE_MODE=whole                # 요청에 방식이 없을 때: whole | tile (설정 화면에서 고르면 그 값이 우선)
# DOCCHAT_TILE_SIZE=1536                  # 타일 한 변의 상한(px)
# DOCCHAT_TILE_OVERLAP=0.125              # 이웃 타일과 겹치는 비율. 키우면 경계에서 잘리는 글자가 줄고 타일 수가 는다
# DOCCHAT_TILE_RENDER_DPI=200             # PDF 타일 렌더 DPI(스캔 쪽은 박힌 이미지 해상도가 상한)
# DOCCHAT_TILE_MIN_SOURCE_EDGE=2048       # 원본 긴 변이 이 이하면 타일로 나누지 않는다
# DOCCHAT_MAX_TILES_PER_IMAGE=48          # 한 장의 타일 수 상한(넘으면 해상도를 낮춘다)
# DOCCHAT_TILE_BLANK_PIXEL_RATIO=0.00002  # 배경과 다른 픽셀이 이 비율 이하면 빈 타일(보내지 않음)
# DOCCHAT_TILE_BLANK_TOLERANCE=24         # 배경으로 치는 밝기 차이(0~255)
# DOCCHAT_TILE_DEDUPE_MIN_CHARS=6         # 겹침 중복으로 지울 수 있는 줄의 최소 길이
# DOCCHAT_TILE_BOX_MERGE_IOU=0.5          # 다른 타일의 박스를 같은 대상으로 보는 IoU
# DOCCHAT_TILE_BOX_MERGE_CONTAINMENT=0.8  # 작은 박스가 이만큼 겹치면 같은 대상

# ─── PDF 쪽 판별 · 전체 이미지 한도 ───────────────────────────────────────
# DOCCHAT_NATIVE_MIN_CHARS=24             # 이 글자 수 이상이면 네이티브 텍스트 사용
# DOCCHAT_SPARSE_OVERLAY_CHARS=120        # 래스터가 있는데 이 미만이면 비전 전사
# DOCCHAT_PDF_RENDER_DPI=200
# DOCCHAT_MAX_VISION_IMAGE_EDGE=3072
# DOCCHAT_MAX_VISION_IMAGE_PIXELS=8000000
# DOCCHAT_MAX_PDF_VISUAL_PAGES=60         # 최대 200

# ─── 전사(OCR) · bbox ────────────────────────────────────────────────────
# DOCCHAT_OCR_RETRY_COUNT=3
# DOCCHAT_OCR_CONCURRENCY=2               # 동시에 나가는 전사·타일 호출 수
# DOCCHAT_OCR_CACHE_LIMIT=256
# DOCCHAT_GROUNDING_RETRY_COUNT=2
# DOCCHAT_MAX_GROUNDING_REGIONS=200

# ─── 전사(OCR) · bbox 호출의 폭주 막기 ────────────────────────────────────
# 추론형 모델은 타일 하나를 두고 같은 생각을 맴돌다 끝나지 않는 일이 있다. 로컬(OpenAI 호환) 서버에만 적용된다.
# DOCCHAT_GROUNDING_DISABLE_THINKING=1    # bbox 호출은 추론 끄기(요청에 값이 없을 때. 설정 화면에서 고르면 그 값이 우선)
# DOCCHAT_OCR_DISABLE_THINKING=1          # 전사 호출은 추론 끄기(위와 같음)
# DOCCHAT_VISION_MAX_TOKENS=4096          # bbox·전사 호출 한 번의 출력 토큰 상한(추론 토큰 포함). 0이면 상한 없음
#                                         #   상한에 닿은 호출은 다시 보내지 않는다.
#                                         #   bbox·전사에 추론을 켜면 8000 이상으로 — 추론만으로 3,500~7,000토큰을 쓴다(Qwen3.5 실측)

# ─── 답변 루프 · 컨텍스트 ─────────────────────────────────────────────────
# DOCCHAT_MAX_TOOL_STEPS=8
# DOCCHAT_REPEATED_TOOL_CALL_LIMIT=3
# DOCCHAT_MAX_CONTINUATIONS=8
# DOCCHAT_MAX_MODEL_IMAGES=12             # 답변 호출 한 번에 싣는 이미지 수
# DOCCHAT_MAX_HISTORY_MESSAGES=30
# DOCCHAT_MAX_ATTACHMENTS_PER_MESSAGE=12
# DOCCHAT_DEFAULT_CONTEXT_TOKENS=8192     # 요청에 컨텍스트 크기가 없을 때
# DOCCHAT_LOCAL_TIMEOUT=3600              # 로컬 모델 응답 대기(초)
# DOCCHAT_CLOUD_TIMEOUT=180

# ─── 스크립트(e2e_check.py, compare_tiling.py)가 쓸 모델 ──────────────────
# DOCCHAT_E2E_PROVIDER=openaiCompatible
# DOCCHAT_E2E_BASE_URL=http://127.0.0.1:11434/v1
# DOCCHAT_E2E_MODEL=gemma3:latest
# DOCCHAT_E2E_CONTEXT=8192
